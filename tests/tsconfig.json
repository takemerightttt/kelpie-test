{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "module": "preserve",
    "target": "es2022",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["jest", "node"],
    "paths": {
      "@/*": ["../src/*"]
    }
  },
  "include": ["**/*.ts", "../src/core/**/*.ts"]
}
